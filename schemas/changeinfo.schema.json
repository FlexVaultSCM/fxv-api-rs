{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fxv:schema:changeinfo:v1",
  "title": "fxv changeinfo command payload",
  "description": "Payload schema for the changeinfo command's JSON output.",
  "type": "object",
  "required": [
    "commit",
    "commit_hash",
    "author_id",
    "author_display_name",
    "author_details",
    "timestamp_millis",
    "summary",
    "changes"
  ],
  "additionalProperties": false,
  "properties": {
    "commit": {
      "$ref": "urn:fxv:schema:common:v1#/$defs/commitInfo"
    },
    "commit_hash": {
      "type": "string",
      "description": "Hex-encoded commit hash."
    },
    "description": {
      "type": "string",
      "description": "Commit description, if present."
    },
    "author_id": {
      "type": "string",
      "description": "Stable display identifier for the author."
    },
    "author_display_name": {
      "type": "string",
      "description": "Human-readable author display name."
    },
    "author_details": {
      "$ref": "urn:fxv:schema:common:v1#/$defs/authorDetails",
      "description": "Structured, internally-tagged author information."
    },
    "import_info": {
      "$ref": "urn:fxv:schema:common:v1#/$defs/importInfo",
      "description": "Source-specific import provenance, present only for imported commits."
    },
    "timestamp_millis": {
      "type": "integer",
      "description": "Commit timestamp in milliseconds since epoch (UTC)."
    },
    "summary": {
      "type": "object",
      "required": [
        "total_changed",
        "added",
        "modified",
        "deleted"
      ],
      "additionalProperties": false,
      "properties": {
        "total_changed": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Workspace-relative path with '/' separators."
          },
          "action": {
            "$ref": "urn:fxv:schema:common:v1#/$defs/changeKind"
          },
          "size": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "File size in bytes, if available."
          },
          "old_hash": {
            "type": ["string", "null"],
            "description": "Previous content/tree address before change."
          },
          "new_hash": {
            "type": ["string", "null"],
            "description": "New content/tree address after change."
          }
        }
      }
    }
  }
}
